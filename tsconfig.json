{
  "compilerOptions": {
    "outDir": "dist",
    "module": "esnext",
    "moduleResolution": "bundler",
    "target": "es2023",
    "lib": [
      "es2023"
    ],
    "types": [
      "node"
    ],
    "esModuleInterop": true,
    "ignoreDeprecations": "6.0",
    "sourceMap": true,
    "noEmit": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "strict": true,
    "jsx": "react-jsx",
    "verbatimModuleSyntax": false,
    "isolatedModules": true,
    "noUncheckedSideEffectImports": true,
    "moduleDetection": "force",
    "skipLibCheck": true
  },
  "include": [
    "src/**/*",
    "generated/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ],
  "baseUrl": ".",
  "paths": {
    "@/*": [
      "./src/*"
    ],
    "@/components/*": [
      "./src/components/*"
    ],
    "@/docs/*": [
      "./src/docs/*"
    ],
    "@/errors/*": [
      "./src/errors/*"
    ]
  }
}